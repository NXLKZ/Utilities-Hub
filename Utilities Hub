        else botaoVoo.Text = L("voar"); tween(botaoVoo, {BackgroundColor3 = COR.botaoOff}, 0.15) end
    end
    local function ativarVoo()
        voando = true; setVooV(true)
        local ch = player.Character; if not ch then return end
        local root = ch:FindFirstChild("HumanoidRootPart"); local hum = ch:FindFirstChildOfClass("Humanoid")
        if not root or not hum then return end
        hum.PlatformStand = true; hum.AutoRotate = false
        root.Velocity = Vector3.zero; root.RotVelocity = Vector3.zero
        local att = Instance.new("Attachment"); att.Name = "VooAtt"; att.Parent = root
        local al = Instance.new("AlignOrientation"); al.Name = "VooAlign"; al.Attachment0 = att
        al.Mode = Enum.OrientationAlignmentMode.OneAttachment; al.RigidityEnabled = true; al.Parent = root
        local tk = {}
        local c1 = UserInputService.InputBegan:Connect(function(i, g) if g then return end tk[i.KeyCode] = true end)
        local c2 = UserInputService.InputEnded:Connect(function(i) tk[i.KeyCode] = false end)
        local c3 = RunService.RenderStepped:Connect(function()
            if not voando or not ch.Parent then return end
            local r = ch:FindFirstChild("HumanoidRootPart"); if not r then return end
            al.CFrame = CFrame.lookAt(Vector3.zero, camera.CFrame.LookVector)
            local d = Vector3.zero; local lk = camera.CFrame.LookVector; local rt = camera.CFrame.RightVector
            if tk[Enum.KeyCode.W] then d += lk end
            if tk[Enum.KeyCode.S] then d -= lk end
            if tk[Enum.KeyCode.A] then d -= rt end
            if tk[Enum.KeyCode.D] then d += rt end
            if tk[Enum.KeyCode.Space] then d += Vector3.new(0,1,0) end
            if tk[Enum.KeyCode.LeftControl] then d -= Vector3.new(0,1,0) end
            local v = velocidadeRef
            if tk[Enum.KeyCode.LeftShift] then v = velocidadeRef * 2 end
            r.Velocity = d.Magnitude > 0 and (d.Unit * v) or Vector3.zero
        end)
        pararVoo = function()
            c1:Disconnect(); c2:Disconnect(); c3:Disconnect()
            if root then
                root.Velocity = Vector3.zero; root.RotVelocity = Vector3.zero
                local a = root:FindFirstChild("VooAlign"); if a then a:Destroy() end
                local at = root:FindFirstChild("VooAtt"); if at then at:Destroy() end
            end
            if hum then hum.PlatformStand = false; hum.AutoRotate = true end
        end
    end
    local function desativarVoo()
        voando = false; setVooV(false); if pararVoo then pararVoo(); pararVoo = nil end
    end
