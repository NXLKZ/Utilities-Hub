    local espAtivo, espBoxes, conexoesEsp = false, {}, {}
    local function aplicarEsp(alvo)
        if alvo == player or espBoxes[alvo] or not alvo.Character then return end
        local ch = alvo.Character; if not ch:FindFirstChild("HumanoidRootPart") then return end
        local h = Instance.new("Highlight"); h.FillTransparency = 1; h.OutlineColor = Color3.fromRGB(255,60,60)
        h.OutlineTransparency = 0; h.DepthMode = Enum.HighlightDepthMode.AlwaysOnTop
        h.Adornee = ch; h.Parent = ch
        local head = ch:FindFirstChild("Head"); local nb, vb
        if head then
            nb = Instance.new("BillboardGui"); nb.Adornee = head; nb.Size = UDim2.new(0,200,0,24)
            nb.StudsOffset = Vector3.new(0,3,0); nb.AlwaysOnTop = true; nb.Parent = head
            local nl = Instance.new("TextLabel"); nl.Size = UDim2.new(1,0,1,0); nl.BackgroundTransparency = 1
            nl.Text = alvo.DisplayName ~= "" and alvo.DisplayName or alvo.Name
            nl.TextColor3 = COR.texto; nl.TextStrokeTransparency = 0; nl.Font = Enum.Font.GothamBold
            nl.TextSize = 15; nl.Parent = nb
            vb = Instance.new("BillboardGui"); vb.Adornee = head; vb.Size = UDim2.new(0,100,0,7)
            vb.StudsOffset = Vector3.new(0,2.2,0); vb.AlwaysOnTop = true; vb.Parent = head
            local f = Instance.new("Frame"); f.Size = UDim2.new(1,0,1,0); f.BackgroundColor3 = Color3.fromRGB(25,25,30)
            f.BorderSizePixel = 0; f.Parent = vb; corner(f, 4)
            local b = Instance.new("Frame"); b.Size = UDim2.new(1,0,1,0); b.BackgroundColor3 = Color3.fromRGB(80,200,120)
            b.BorderSizePixel = 0; b.Parent = f; corner(b, 4)
            local hum = ch:FindFirstChildOfClass("Humanoid")
            if hum then
                local function up()
                    local p = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
                    b.Size = UDim2.new(p,0,1,0)
                    if p > 0.5 then b.BackgroundColor3 = Color3.fromRGB(80,200,120)
                    elseif p > 0.25 then b.BackgroundColor3 = Color3.fromRGB(230,200,60)
                    else b.BackgroundColor3 = Color3.fromRGB(230,80,80) end
                end
                up(); table.insert(conexoesEsp, hum.HealthChanged:Connect(up))
            end
        end
        espBoxes[alvo] = {Box = h, NomeBill = nb, VidaBill = vb}
    end
    local function removerEsp(a)
        local e = espBoxes[a]; if not e then return end
        if e.Box then e.Box:Destroy() end
        if e.NomeBill then e.NomeBill:Destroy() end
        if e.VidaBill then e.VidaBill:Destroy() end
        espBoxes[a] = nil
    end
    local function limparEsp()
        for a, _ in pairs(espBoxes) do removerEsp(a) end
        for _, c in ipairs(conexoesEsp) do pcall(function() c:Disconnect() end) end
        conexoesEsp = {}
    end
