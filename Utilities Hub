    local sp = Instance.new("UIPadding"); sp.PaddingTop = UDim.new(0,8); sp.PaddingLeft = UDim.new(0,6); sp.PaddingRight = UDim.new(0,6); sp.Parent = sidebar

    local contentArea = Instance.new("Frame"); contentArea.Size = UDim2.new(1,-134,1,-58)
    contentArea.Position = UDim2.new(0,126,0,50); contentArea.BackgroundTransparency = 1; contentArea.Parent = frame

    -- Sistema de categorias
    local cats = {}; local pages = {}
    local function criarCatBtn(ic, txt, ord)
        local b = Instance.new("TextButton"); b.Size = UDim2.new(1,0,0,42)
        b.BackgroundColor3 = COR.tabInativa; b.Text = ic .. "  " .. txt; b.TextColor3 = COR.sub
        b.Font = Enum.Font.GothamBold; b.TextSize = 12; b.TextXAlignment = Enum.TextXAlignment.Left
        b.LayoutOrder = ord; b.AutoButtonColor = false; b.Parent = sidebar; corner(b, 8)
        local p = Instance.new("UIPadding"); p.PaddingLeft = UDim.new(0,8); p.Parent = b
        return b
    end
    local function criarPagina(nome)
        local p = Instance.new("ScrollingFrame"); p.Name = nome; p.Size = UDim2.new(1,0,1,0)
        p.BackgroundTransparency = 1; p.BorderSizePixel = 0; p.ScrollBarThickness = 3
        p.ScrollBarImageColor3 = COR.acento; p.CanvasSize = UDim2.new(0,0,0,0)
        p.AutomaticCanvasSize = Enum.AutomaticSize.Y; p.Visible = false; p.Parent = contentArea
        local l = Instance.new("UIListLayout"); l.Padding = UDim.new(0,6); l.SortOrder = Enum.SortOrder.LayoutOrder; l.Parent = p
        local pad = Instance.new("UIPadding"); pad.PaddingRight = UDim.new(0,4); pad.Parent = p
        return p
    end
    local function ativarCat(n)
        for nome, b in pairs(cats) do
            if nome == n then tween(b, {BackgroundColor3 = COR.tabAtiva, TextColor3 = COR.texto}, 0.15)
            else tween(b, {BackgroundColor3 = COR.tabInativa, TextColor3 = COR.sub}, 0.15) end
        end
        for nome, p in pairs(pages) do p.Visible = (nome == n) end
    end
    local function registrarCat(nome, ic, txt, ord)
        local b = criarCatBtn(ic, txt, ord); cats[nome] = b
        b.MouseButton1Click:Connect(function() ativarCat(nome) end)
    end
    registrarCat("Main", "⚙", L("catMain"), 1)
    registrarCat("Misc", "🔧", L("catMisc"), 2)
    registrarCat("Fun", "🎉", L("catFun"), 3)
    registrarCat("Punish", "🔨", L("catPunish"), 4)
    pages["Main"] = criarPagina("Main"); pages["Misc"] = criarPagina("Misc")
    pages["Fun"] = criarPagina("Fun"); pages["Punish"] = criarPagina("Punish")
    ativarCat("Main")

    -- Helpers UI
    local function criarToggle(parent, texto, ordem)
        local b = Instance.new("TextButton"); b.Size = UDim2.new(1,-6,0,42)
        b.BackgroundColor3 = COR.botaoOff; b.Text = texto; b.TextColor3 = COR.texto
        b.Font = Enum.Font.GothamMedium; b.TextSize = 13; b.LayoutOrder = ordem
        b.AutoButtonColor = false; b.Parent = parent; corner(b, 8); stroke(b)
        b.MouseEnter:Connect(function()
            if b.BackgroundColor3 ~= COR.botaoOn and b.BackgroundColor3 ~= COR.amarelo then
                tween(b, {BackgroundColor3 = COR.botaoHover}, 0.12)
            end
        end)
        b.MouseLeave:Connect(function()
            if b.BackgroundColor3 ~= COR.botaoOn and b.BackgroundColor3 ~= COR.amarelo then
                tween(b, {BackgroundColor3 = COR.botaoOff}, 0.12)
