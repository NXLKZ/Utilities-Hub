            ghost.Material = Enum.Material.Neon; ghost.Color = Color3.fromRGB(255, 240, 80)
            ghost.Transparency = 0.3; ghost.CanCollide = false; ghost.Anchored = true
            ghost.CastShadow = false; ghost.Parent = workspace
            for i = 1, 3 do
                local raio = Instance.new("Part")
                raio.Size = Vector3.new(0.15, 0.15, math.random(2, 6))
                raio.CFrame = hrp.CFrame * CFrame.new(math.random(-3,3), math.random(-2,2), math.random(-3,3))
                raio.Material = Enum.Material.Neon; raio.Color = Color3.fromRGB(120, 220, 255)
                raio.CanCollide = false; raio.Anchored = true; raio.CastShadow = false
                raio.Parent = workspace
                task.spawn(function()
                    for i2 = 1, 6 do raio.Transparency = i2 / 6; task.wait(0.03) end
                    raio:Destroy()
                end)
            end
            task.spawn(function()
                for i = 1, 10 do
                    ghost.Transparency = 0.3 + (i / 10) * 0.7
                    task.wait(0.03)
                end
                ghost:Destroy()
            end)
        end)
    end

    local function pararFlash()
        if conexaoFlash then conexaoFlash:Disconnect(); conexaoFlash = nil end
        local c = player.Character
        if c then
            local hum = c:FindFirstChildOfClass("Humanoid")
            if hum then hum.WalkSpeed = walkSpeedOriginal end
        end
    end

    botaoFlash.MouseButton1Click:Connect(function()
        funAtivo.flash = not funAtivo.flash
        setVis(botaoFlash, funAtivo.flash, L("flashMode"), L("flashModeOn"), COR.amarelo)
        if funAtivo.flash then iniciarFlash() else pararFlash() end
    end)

    -- STATS
    criarSection(pages["Fun"], L("secStats"), 20)
    criarSlider(pages["Fun"], L("funVel"), 16, 200, 16, 21, function(v)
        local c = player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.WalkSpeed = v end
    end, function(v) return tostring(math.floor(v)) end)
    criarSlider(pages["Fun"], L("funJumpPow"), 50, 500, 50, 22, function(v)
        local c = player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
        if h then h.JumpPower = v; h.UseJumpPower = true end
    end, function(v) return tostring(math.floor(v)) end)
    criarSlider(pages["Fun"], L("funSize"), 0.5, 3, 1, 23, function(v)
        local c = player.Character; local h = c and c:FindFirstChildOfClass("Humanoid")
        if not h then return end
        for _, n in ipairs({"BodyDepthScale", "BodyWidthScale", "BodyHeightScale", "HeadScale"}) do
            local s = h:FindFirstChild(n); if s then pcall(function() s.Value = v end) end
        end
    end, function(v) return string.format("%.2f", v) end)

    -- ============================================
    -- PUNISH
    -- ============================================
    local alvoCarregado = nil
    local conexaoCarregar = nil

    criarSection(pages["Punish"], L("escolhePunish"), 1)
    local subPunish = subCont(pages["Punish"], 2)

    -- Sticky bar PUNISH
    local punishBar = Instance.new("Frame")
    punishBar.Size = UDim2.new(1, -20, 0, 56)
    punishBar.Position = UDim2.new(0, 10, 1, -66)
    punishBar.BackgroundColor3 = COR.roxo
    punishBar.BorderSizePixel = 0
    punishBar.Visible = false
    punishBar.ZIndex = 7
    punishBar.Parent = frame
    corner(punishBar, 10)

    local pnL = Instance.new("TextLabel")
    pnL.Size = UDim2.new(1, -16, 0, 16); pnL.Position = UDim2.new(0, 8, 0, 6)
    pnL.BackgroundTransparency = 1; pnL.Text = L("punishLoading")
    pnL.TextColor3 = Color3.fromRGB(230, 200, 255); pnL.Font = Enum.Font.GothamBold
    pnL.TextSize = 10; pnL.TextXAlignment = Enum.TextXAlignment.Left; pnL.Parent = punishBar

    local pnN = Instance.new("TextLabel")
    pnN.Size = UDim2.new(1, -16, 0, 16); pnN.Position = UDim2.new(0, 8, 0, 20)
    pnN.BackgroundTransparency = 1; pnN.Text = "—"; pnN.TextColor3 = COR.texto
    pnN.Font = Enum.Font.GothamBold; pnN.TextSize = 13
    pnN.TextXAlignment = Enum.TextXAlignment.Left; pnN.TextTruncate = Enum.TextTruncate.AtEnd
    pnN.Parent = punishBar

    local pnB = Instance.new("TextButton")
    pnB.Size = UDim2.new(0, 100, 0, 38); pnB.Position = UDim2.new(1, -108, 0.5, -19)
    pnB.BackgroundColor3 = Color3.fromRGB(255, 255, 255); pnB.Text = L("punishRelease")
    pnB.TextColor3 = COR.roxo; pnB.Font = Enum.Font.GothamBold; pnB.TextSize = 11
    pnB.AutoButtonColor = false; pnB.Parent = punishBar; corner(pnB, 8)
    pnB.MouseEnter:Connect(function() tween(pnB, {BackgroundColor3 = Color3.fromRGB(245, 235, 255)}, 0.12) end)
    pnB.MouseLeave:Connect(function() tween(pnB, {BackgroundColor3 = Color3.fromRGB(255, 255, 255)}, 0.12) end)

    local function atualizarPunishUI()
        if alvoCarregado then
            punishBar.Visible = true
            pnN.Text = "@" .. alvoCarregado.Name
        else
            punishBar.Visible = false
        end
    end

    local carregarPlayer

    local function largarPlayer()
        if conexaoCarregar then conexaoCarregar:Disconnect(); conexaoCarregar = nil end
        if alvoCarregado and alvoCarregado.Character then
            local hrp = alvoCarregado.Character:FindFirstChild("HumanoidRootPart")
            if hrp then pcall(function() hrp.Anchored = false end) end
        end
        alvoCarregado = nil
        atualizarPunishUI()
        construirLista(subPunish, carregarPlayer, nil)
    end

    pnB.MouseButton1Click:Connect(largarPlayer)

    carregarPlayer = function(alvo)
        if alvoCarregado == alvo then largarPlayer(); return end

        if conexaoCarregar then
            conexaoCarregar:Disconnect(); conexaoCarregar = nil
            if alvoCarregado and alvoCarregado.Character then
                local hrp = alvoCarregado.Character:FindFirstChild("HumanoidRootPart")
                if hrp then pcall(function() hrp.Anchored = false end) end
            end
        end

        local tc = alvo.Character; if not tc then return end
        local th = tc:FindFirstChild("HumanoidRootPart"); if not th then return end

        alvoCarregado = alvo
        pcall(function() th.Anchored = true end)

        conexaoCarregar = RunService.RenderStepped:Connect(function()
            if not alvoCarregado then return end
            local tcc = alvoCarregado.Character
            if not tcc then
                task.defer(function()
                    if alvoCarregado then largarPlayer() end
                end)
                return
            end
            local thh = tcc:FindFirstChild("HumanoidRootPart"); if not thh then return end
            local myC = player.Character; if not myC then return end
            local myH = myC:FindFirstChild("HumanoidRootPart"); if not myH then return end

            -- Coloca em cima da minha cabeça (4.5 studs acima do meu HRP)
            thh.CFrame = myH.CFrame * CFrame.new(0, 4.5, 0)
            thh.Velocity = Vector3.zero
            thh.RotVelocity = Vector3.zero
        end)

        atualizarPunishUI()
        construirLista(subPunish, carregarPlayer, alvoCarregado)
    end

    construirLista(subPunish, carregarPlayer)

    Players.PlayerAdded:Connect(function()
        task.wait(0.3)
        construirLista(subPunish, carregarPlayer, alvoCarregado)
    end)
    Players.PlayerRemoving:Connect(function(p)
        if alvoCarregado == p then largarPlayer() end
    end)

    -- ============================================
    -- RESET AO RESPAWNAR
    -- ============================================
    player.CharacterAdded:Connect(function()
        if voando then voando = false; setVooV(false); pararVoo = nil end
        if conexaoGrudar then conexaoGrudar:Disconnect(); conexaoGrudar = nil; alvoGrudado = nil; updSticky() end
        if funAtivo.flash then
            funAtivo.flash = false
            setVis(botaoFlash, false, L("flashMode"), L("flashModeOn"))
            pararFlash()
        end
        if alvoCarregado then largarPlayer() end
        task.wait(0.5)
        if espAtivo then for _, a in ipairs(Players:GetPlayers()) do aplicarEsp(a) end end
    end)

    abrirAnim()
end

