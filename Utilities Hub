local function mostrarSelecaoLingua(onEscolha)
    local canvas = Instance.new("CanvasGroup")
    canvas.Size = UDim2.new(1,0,1,0); canvas.BackgroundColor3 = Color3.fromRGB(10,12,16)
    canvas.BackgroundTransparency = 0.15; canvas.BorderSizePixel = 0; canvas.ZIndex = 100; canvas.Parent = screenGui
    local uiScale = Instance.new("UIScale"); uiScale.Scale = 0.85; uiScale.Parent = canvas
    local blur = Instance.new("BlurEffect"); blur.Size = 0; blur.Parent = camera
    tween(blur, {Size = 24}, 0.5)

    local t1 = Instance.new("TextLabel"); t1.Size = UDim2.new(1,0,0,40); t1.Position = UDim2.new(0,0,0.5,-180)
    t1.BackgroundTransparency = 1; t1.Text = "🌍   Language  /  Idioma"
    t1.TextColor3 = COR.texto; t1.Font = Enum.Font.GothamBold; t1.TextSize = 26; t1.Parent = canvas
    local t2 = Instance.new("TextLabel"); t2.Size = UDim2.new(1,0,0,24); t2.Position = UDim2.new(0,0,0.5,-140)
    t2.BackgroundTransparency = 1; t2.Text = "Choose your language   •   Escolhe o teu idioma"
    t2.TextColor3 = COR.sub; t2.Font = Enum.Font.GothamMedium; t2.TextSize = 14; t2.Parent = canvas

    local cc = Instance.new("Frame"); cc.Size = UDim2.new(0,400,0,240); cc.Position = UDim2.new(0.5,-200,0.5,-60)
    cc.BackgroundTransparency = 1; cc.Parent = canvas
    local cl = Instance.new("UIListLayout"); cl.FillDirection = Enum.FillDirection.Horizontal
    cl.Padding = UDim.new(0,20); cl.HorizontalAlignment = Enum.HorizontalAlignment.Center
    cl.VerticalAlignment = Enum.VerticalAlignment.Center; cl.Parent = cc

    local function card(nome, flagFn, cod)
        local c = Instance.new("TextButton"); c.Size = UDim2.new(0,180,0,230)
        c.BackgroundColor3 = Color3.fromRGB(26,30,40); c.Text = ""; c.AutoButtonColor = false; c.Parent = cc
        corner(c, 16); local s = stroke(c, COR.stroke, 1.5)
        local fb = Instance.new("Frame"); fb.Size = UDim2.new(0,130,0,86); fb.Position = UDim2.new(0.5,-65,0,30)
        fb.BackgroundColor3 = Color3.fromRGB(20,20,26); fb.BorderSizePixel = 0; fb.Parent = c; corner(fb,12)
        local fw = Instance.new("Frame"); fw.Size = UDim2.new(0,110,0,72); fw.Position = UDim2.new(0.5,-55,0.5,-36)
        fw.BackgroundTransparency = 1; fw.Parent = fb; flagFn(fw)
        local lb = Instance.new("TextLabel"); lb.Size = UDim2.new(1,-20,0,32); lb.Position = UDim2.new(0,10,0,140)
        lb.BackgroundTransparency = 1; lb.Text = nome; lb.TextColor3 = COR.texto
        lb.Font = Enum.Font.GothamBold; lb.TextSize = 20; lb.Parent = c
        local sb = Instance.new("TextLabel"); sb.Size = UDim2.new(1,-20,0,20); sb.Position = UDim2.new(0,10,0,172)
        sb.BackgroundTransparency = 1; sb.Text = cod; sb.TextColor3 = COR.sub
        sb.Font = Enum.Font.GothamMedium; sb.TextSize = 12; sb.Parent = c
        c.MouseEnter:Connect(function()
            tween(c, {BackgroundColor3 = Color3.fromRGB(38,44,58)}, 0.15)
            tween(s, {Color = COR.acento, Thickness = 2}, 0.15)
        end)
        c.MouseLeave:Connect(function()
            tween(c, {BackgroundColor3 = Color3.fromRGB(26,30,40)}, 0.15)
            tween(s, {Color = COR.stroke, Thickness = 1.5}, 0.15)
        end)
        return c
    end

    local cPT = card("Português", criarBandeiraPT, "PT")
    local cEN = card("English", criarBandeiraUK, "EN")
    canvas.GroupTransparency = 1
    tween(canvas, {GroupTransparency = 0}, 0.4)
    tween(uiScale, {Scale = 1}, 0.5, Enum.EasingStyle.Back, Enum.EasingDirection.Out)

    local function escolher(e)
        tween(canvas, {GroupTransparency = 1}, 0.35)
        tween(uiScale, {Scale = 0.9}, 0.35, Enum.EasingStyle.Quad, Enum.EasingDirection.In)
        tween(blur, {Size = 0}, 0.4); task.wait(0.4); blur:Destroy(); canvas:Destroy(); onEscolha(e)
    end
    cPT.MouseButton1Click:Connect(function() escolher("pt") end)
    cEN.MouseButton1Click:Connect(function() escolher("en") end)
end

