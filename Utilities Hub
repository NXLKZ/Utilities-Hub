    f.BorderSizePixel = 0; f.ClipsDescendants = true; f.Parent = parent; corner(f, 8)
    local function diag(rot, thick, cor, z)
        local d = Instance.new("Frame"); d.Size = UDim2.new(0,140,0,thick)
        d.Position = UDim2.new(0.5,-70,0.5,-thick/2); d.Rotation = rot
        d.BackgroundColor3 = cor; d.BorderSizePixel = 0; d.ZIndex = z; d.Parent = f
    end
