        else botaoEsp.Text = L("esp"); tween(botaoEsp, {BackgroundColor3 = COR.botaoOff}, 0.15) end
    end
    local function ligarEsp()
        espAtivo = true; setEspV(true)
        for _, a in ipairs(Players:GetPlayers()) do
            aplicarEsp(a)
            if a ~= player then
                table.insert(conexoesEsp, a.CharacterAdded:Connect(function()
                    task.wait(0.5); if espAtivo then aplicarEsp(a) end
                end))
            end
        end
        table.insert(conexoesEsp, Players.PlayerAdded:Connect(function(a)
            a.CharacterAdded:Connect(function() task.wait(0.5); if espAtivo then aplicarEsp(a) end end)
        end))
        table.insert(conexoesEsp, Players.PlayerRemoving:Connect(function(a) removerEsp(a) end))
    end
    local function desligarEsp()
        espAtivo = false; setEspV(false); limparEsp()
    end
