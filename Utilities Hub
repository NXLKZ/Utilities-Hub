-- Helpers
local function tween(obj, props, tempo, estilo, dir)
    TweenService:Create(obj, TweenInfo.new(tempo or 0.2, estilo or Enum.EasingStyle.Quad, dir or Enum.EasingDirection.Out), props):Play()
end
local function corner(parent, raio)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, raio or 10); c.Parent = parent; return c
end
local function stroke(parent, cor, esp)
    local s = Instance.new("UIStroke"); s.Color = cor or COR.stroke; s.Thickness = esp or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = parent; return s
end

